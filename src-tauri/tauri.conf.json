{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "astralis-vinyl",
  "version": "0.1.2",
  "identifier": "com.asus.astralis-vinyl",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
        {
          "title": "astralis-vinyl",
          "width": 800,
          "height": 600
        }
      ],
      "security": {
        "assetProtocol": {
          "enable": true,
          "scope": ["**"]
        }
      }
  },
  "bundle": {
      "active": true,
      "targets": "all",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "resources": [
        "bin/*" 
      ]
    }
}
