{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "astralis-vinyl",
  "version": "1.5.0",
  "identifier": "com.asus.astralis-vinyl",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "astralis-vinyl",
        "width": 1280,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 720,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost https://lrclib.net; img-src 'self' asset: http://asset.localhost data: https:; media-src 'self' asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": ["bin/*"]
  }
}
